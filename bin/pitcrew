#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
#  pitcrew — interactive local dev-stack launcher for multi-service monorepos
#
#  Starts docker deps and backend/frontend processes as plain background
#  processes (RAM-capped via systemd-run --user --scope when systemd is
#  available), with a live dashboard, per-service RAM/CPU meters, an error
#  radar over the logs, and fzf menus. No terminal multiplexer required.
#
#  Config-driven: run it from inside a project that has a pitcrew.config.sh
#  (walked up from $PWD, or point PITCREW_CONFIG at one). See
#  examples/pitcrew.config.example.sh for the schema.
#
#  Linux is the primary target. macOS works the same way through portable
#  (ps/lsof/vm_stat) equivalents of the Linux-only bits. On Windows, run
#  inside WSL2 — there pitcrew just sees a normal Linux userland.
# ─────────────────────────────────────────────────────────────────────────────
set -u

# pitcrew leans on bash 5 features throughout: $EPOCHREALTIME for fork-free
# timing, negative array indices, `declare -gA`, `printf -v arr[i]`. Without
# this guard an old bash fails with a syntax error from a random lib file,
# which tells the user nothing. macOS still ships bash 3.2, so this is the
# single most likely way someone meets this tool for the first time.
#
# Which means THIS FILE must stay parseable by bash 3.2 — no `declare -A`, no
# `mapfile`, no `${x^^}` anywhere in it. bash parses a script whole before it
# runs a line of it, so one bash-5-only construct here and the guard below
# never gets the chance to print anything. The lib/ files are sourced after
# the guard and are under no such restriction. CI checks this on a real 3.2.
if [ "${BASH_VERSINFO[0]:-0}" -lt 5 ]; then
  printf 'pitcrew needs bash 5.0 or newer (found %s).
' "${BASH_VERSION:-unknown}" >&2
  case "$(uname -s)" in
    Darwin) printf 'On macOS: brew install bash, then re-run pitcrew.
' >&2 ;;
    *)      printf 'Install a newer bash and make sure it is first on your PATH.
' >&2 ;;
  esac
  exit 1
fi

# install.sh puts a symlink on $PATH, so this has to resolve to the real file
# before it can find lib/. `readlink -f` is a GNU extension — macOS only grew
# it in 12.3, and `greadlink` only exists if someone installed coreutils, so
# neither can be relied on. Walking the links by hand needs no tool at all.
# The hop limit is what a symlink loop hits instead of hanging forever.
SELF="${BASH_SOURCE[0]}"
for ((_hop = 0; _hop < 40; _hop++)); do
  [ -L "$SELF" ] || break
  _target=$(readlink "$SELF")            # plain readlink is POSIX; -f is not
  case "$_target" in
    /*) SELF=$_target ;;
    *)  SELF="$(dirname "$SELF")/$_target" ;;
  esac
done
# Read, not baked in: the file is the single place a release number lives, and
# `pitcrew --version` is how someone reporting a bug tells you what they ran.
PITCREW_VERSION=$(cat "$(dirname "$SELF")/../VERSION" 2>/dev/null) || PITCREW_VERSION=unknown
case "${1:-}" in
  --version|-V) printf 'pitcrew %s\n' "${PITCREW_VERSION:-unknown}"; exit 0 ;;
esac

LIB_DIR="$(cd "$(dirname "$SELF")/../lib" 2>/dev/null && pwd)" || true
[ -n "$LIB_DIR" ] && [ -d "$LIB_DIR" ] || {
  printf 'pitcrew: cannot locate its own lib/ from %s\n' "${BASH_SOURCE[0]}" >&2
  exit 1
}
for f in "$LIB_DIR"/*.sh; do
  # shellcheck source=/dev/null
  source "$f"
done

usage() {
  cat <<'EOF'
pitcrew — local dev-stack launcher

Usage:
  pitcrew                  live dashboard (default) — l logs · s stop · m menu · q quit
                            observes only — nothing is started for you
                            (in logs: Tab/←→ switch · x stop · r restart · Enter full log)
  pitcrew menu              interactive fzf menu
  pitcrew start [all|backends|frontends|deps|@profile|<app>...]
  pitcrew up                 start whatever isn't already running, then the live dashboard
  pitcrew stop  [all|@profile|<app>...]     stops tool-managed AND external
  pitcrew stop --deps                       also stop non-protected deps
  pitcrew restart <app>...
  pitcrew status [--json]           one-shot dashboard, or machine-readable state
  pitcrew doctor [--json]           check the environment; --json exits non-zero if it is wrong
  pitcrew --version
  pitcrew limit [<component> <size|default>]
                                     per-component RAM caps (no args = show them)
  pitcrew json [--watch [--interval N]]
                                     one state object, or an NDJSON stream
                                     (--watch is the only mode with real cpu%)
  pitcrew wait [<target>...] [--timeout N] [--strict]
                                     block until they are up
                                     exit 0 up · 1 timed out · 2 crashed
                                     --strict rejects ports served by anything
                                     pitcrew did not start
  pitcrew ps                        everything running, across all projects
  pitcrew watch                     same as bare `pitcrew` — live dashboard, no auto-start
  pitcrew logs [<component>]        in-place log viewer
  pitcrew stale [--restart]         apps whose code changed since they started
                                     (needs PITCREW_WATCH_DIR set per app in config)
  pitcrew profile save <name> <targets...> | list | rm <name>
  pitcrew shell [<name>]            run a configured quick shell (PITCREW_SHELLS), foreground
  pitcrew doctor                    check the local environment
  pitcrew init [<dir>]              generate a starter pitcrew.config.sh (default: $PWD)
  pitcrew theme [<name>]            colour palette — bare lists them with swatches
  pitcrew render [<setting> <value>]
                                    how the graphs are drawn (graph · scale · gauge);
                                     bare shows each setting with a live sample
  pitcrew urls | help

Flags (must come before the subcommand):
  -C, --project <dir>       use this project instead of walking up from $PWD
                             <dir> may be a project root or the config file itself
  -p, --name <name>         use a registered project by name

Config discovery, in order: -C/--project · -p/--name · $PITCREW_CONFIG ·
a pitcrew.config.sh walked up from $PWD · a registered project containing $PWD ·
whatever `pitcrew use` last selected.
Env overrides: PITCREW_CONFIG, PITCREW_ROOT, PITCREW_FE_MAX, PITCREW_BE_MAX, PITCREW_WAIT.
EOF
}

while [ $# -gt 0 ]; do
  case "$1" in
    -C|--project)
      [ $# -ge 2 ] || die "-C/--project needs a path"
      PITCREW_PROJECT_DIR=$2
      shift 2
      ;;
    --project=*) PITCREW_PROJECT_DIR="${1#*=}"; shift ;;
    -p|--name)
      [ $# -ge 2 ] || die "-p/--name needs a project name"
      PITCREW_PROJECT_SEL=$2
      shift 2
      ;;
    --name=*) PITCREW_PROJECT_SEL="${1#*=}"; shift ;;
    *) break ;;
  esac
done

case "${1:-}" in
  help|-h|--help) usage; exit 0 ;;
  init)     shift; cmd_init     "$@"; exit $? ;;
  theme)    shift; cmd_theme    "$@"; exit $? ;;
  render)   shift; cmd_render   "$@"; exit $? ;;
  projects|ls) shift; cmd_projects "$@"; exit $? ;;
  ports)    shift; cmd_ports    "$@"; exit $? ;;
  ps)       shift; cmd_ps       "$@"; exit $? ;;
  use)      shift; cmd_use      "$@"; exit $? ;;
  forget)   shift; cmd_forget   "$@"; exit $? ;;
  edit)     shift; cmd_edit     "$@"; exit $? ;;
esac

# Config is sourced here, at the script's top level (not inside a function) —
# see the note atop lib/02-config.sh for why that matters.
PITCREW_CFG=$(find_config) || die "no project here, and none selected.

  pitcrew init <dir>     look at a project and generate a config for it
  pitcrew projects       what pitcrew already knows about
  pitcrew use <name>     work on one of them
  pitcrew -p <name> ...  one command against one of them"
config_defaults
# ROOT must be known before the config is sourced — its start commands are
# written in terms of $ROOT and expand as the file is read.
ROOT=$(config_declared_root "$PITCREW_CFG")
[ -n "$ROOT" ] || ROOT=$(cd "$(dirname "$PITCREW_CFG")" && pwd)
# shellcheck source=/dev/null
source "$PITCREW_CFG"
config_finalize "$PITCREW_CFG"
config_validate
cd "$ROOT" 2>/dev/null || die "project root not found at $ROOT"

# Remembered so that switching project from inside the UI can re-exec into the
# same view the user was already looking at.
PITCREW_CMD=${1:-watch}

case "${1:-watch}" in
  up)              cmd_up ;;
  menu)            menu ;;
  start)   shift;  cmd_start "$@" ;;
  stop)    shift;  cmd_stop "$@" ;;
  restart) shift;  [ $# -ge 1 ] || die "restart needs app names"; cmd_stop "$@"; cmd_start "$@" ;;
  status)  shift; if [ "${1:-}" = --json ]; then cmd_json; else cmd_status; fi ;;
  json)    shift; if [ "${1:-}" = --watch ]; then shift; cmd_json_watch "$@"; else cmd_json; fi ;;
  limit)   shift; cmd_limit "$@"; exit $? ;;
  wait)    shift;  cmd_wait "$@"; exit $? ;;
  watch)           cmd_watch ;;
  logs)    shift;  cmd_logs "$@" ;;
  stale)   shift;  cmd_stale "$@" ;;
  profile) shift;  cmd_profile "$@" ;;
  shell)   shift;  cmd_shell "$@" ;;
  doctor)  shift; if [ "${1:-}" = --json ]; then cmd_doctor_json; exit $?; else cmd_doctor; fi ;;
  urls)            cmd_urls ;;
  *)               die "unknown command '${1}' — try: pitcrew help" ;;
esac
