#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
#  pitcrew — interactive local dev-stack launcher for multi-service monorepos
#
#  Starts docker deps, backend + frontend processes (each RAM-capped via
#  systemd-run) inside one tmux session, with a live dashboard, per-service
#  RAM meters, error radar and fzf menus with log previews.
#
#  Config-driven: run it from inside a project that has a pitcrew.config.sh
#  (walked up from $PWD, or point PITCREW_CONFIG at one). See
#  examples/pitcrew.config.example.sh for the schema.
# ─────────────────────────────────────────────────────────────────────────────
set -u

SELF=$(readlink -f "${BASH_SOURCE[0]}")
LIB_DIR="$(cd "$(dirname "$SELF")/../lib" && pwd)"
for f in "$LIB_DIR"/*.sh; do
  # shellcheck source=/dev/null
  source "$f"
done

usage() {
  cat <<'EOF'
pitcrew — local dev-stack launcher

Usage:
  pitcrew                  live dashboard (default) — l logs · s stop · g grid · m menu · q quit
                            (in logs: Tab/←→ switch · x stop · r restart · Enter attach)
  pitcrew menu              interactive fzf menu
  pitcrew start [all|backends|frontends|deps|@profile|<app>...]
  pitcrew stop  [all|@profile|<app>...]     stops tool-managed AND external
  pitcrew stop --deps                       also stop non-protected deps
  pitcrew restart <app>...
  pitcrew status                    one-shot dashboard
  pitcrew watch                     live auto-refreshing dashboard
  pitcrew grid                      tiled tmux view of ALL service logs
  pitcrew logs [<component>]        in-place log viewer (Tab/←→ switch · Enter attach)
  pitcrew stale [--restart]         apps whose code changed since they started
                                     (needs PITCREW_WATCH_DIR set per app in config)
  pitcrew profile save <name> <targets...> | list | rm <name>
  pitcrew shell [<name>]            open a configured quick shell (PITCREW_SHELLS)
  pitcrew doctor                    check the local environment
  pitcrew attach | urls | help

Config discovery: pitcrew.config.sh, walked up from $PWD, or $PITCREW_CONFIG.
Env overrides: PITCREW_CONFIG, PITCREW_ROOT, PITCREW_FE_MAX, PITCREW_BE_MAX, PITCREW_WAIT.
EOF
}

case "${1:-}" in
  help|-h|--help) usage; exit 0 ;;
esac

# Config is sourced here, at the script's top level (not inside a function) —
# see the note atop lib/01-config.sh for why that matters.
PITCREW_CFG=$(find_config) || die "no pitcrew.config.sh found in $PWD or any parent directory.
Point PITCREW_CONFIG at one, or copy examples/pitcrew.config.example.sh into your project root."
config_defaults
ROOT=$(cd "$(dirname "$PITCREW_CFG")" && pwd)
# shellcheck source=/dev/null
source "$PITCREW_CFG"
config_finalize "$PITCREW_CFG"
cd "$ROOT" 2>/dev/null || die "project root not found at $ROOT"

case "${1:-watch}" in
  menu)            menu ;;
  start)   shift;  cmd_start "$@" ;;
  stop)    shift;  cmd_stop "$@" ;;
  restart) shift;  [ $# -ge 1 ] || die "restart needs app names"; cmd_stop "$@"; cmd_start "$@" ;;
  status)          cmd_status ;;
  watch)           cmd_watch ;;
  grid)            cmd_grid ;;
  logs)    shift;  cmd_logs "$@" ;;
  stale)   shift;  cmd_stale "$@" ;;
  profile) shift;  cmd_profile "$@" ;;
  shell)   shift;  cmd_shell "$@" ;;
  doctor)          cmd_doctor ;;
  attach)          tmux has-session -t "$SESSION" 2>/dev/null && attach_to "$SESSION" || die "nothing is running" ;;
  urls)            cmd_urls ;;
  *)               die "unknown command '${1}' — try: pitcrew help" ;;
esac
