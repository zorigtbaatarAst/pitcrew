#!/usr/bin/env python3
"""pitcrew-gui — a desktop front-end for pitcrew.

A launcher, not the app. It puts the package on the path and makes sure the
interpreter running us can actually import the GTK bindings before importing
anything that needs them; see pitcrewgui/bootstrap.py for why that is a runtime
question rather than a shebang.
"""

import os
import sys

# realpath, not dirname: install.sh symlinks this onto $PATH, and the package
# lives next to the real file, not next to the link.
HERE = os.path.dirname(os.path.realpath(__file__))
if HERE not in sys.path:
    sys.path.insert(0, HERE)

from pitcrewgui.bootstrap import ensure_bindings  # noqa: E402

ensure_bindings(os.path.realpath(__file__), sys.argv[1:])

from pitcrewgui.app import main  # noqa: E402

sys.exit(main(sys.argv))
